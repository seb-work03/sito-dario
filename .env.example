# --- Database (Neon) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- NextAuth ---
AUTH_SECRET=

# --- Admin bootstrap (used only if admin_user table is empty) ---
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Vercel Web Analytics (for the /admin/analytics dashboard) ---
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
# Only needed if the project is inside a Vercel Team (leave empty for personal accounts)
VERCEL_TEAM_ID=

# --- Blob storage ---
BLOB_READ_WRITE_TOKEN=

# --- Transactional email (Resend) ---
# Verify dariotana.it in Resend, then use an address on that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Dario Tana <noreply@dariotana.it>"
CONTACT_NOTIFICATION_EMAIL=info@dariotana.it

# --- Optional article generation ---
ANTHROPIC_API_KEY=
UNSPLASH_ACCESS_KEY=
CRON_SECRET=
